    "auth:test-authz": "tsx scripts/test-action-authz.ts",
    "auth:test-admin": "tsx scripts/test-admin-flows.ts",
    "auth:cleanup-tests": "tsx scripts/cleanup-test-accounts.ts",
    "auth:extract": "node scripts/extract-auth-dump.mjs",
    "auth:test-restart": "bash scripts/test-restart-persistence.sh",
    "auth:test-session": "tsx scripts/test-stale-session.ts",
    "auth:grant-read-all": "tsx scripts/grant-read-all.ts",
    "test:pagination": "tsx scripts/test-pagination.ts",
    "test:documents": "tsx scripts/test-documents.ts",
    "deploy:preflight": "tsx scripts/preflight-deploy.ts",
    "auth:reset-admin": "tsx scripts/reset-admin-password.ts",
    "db:export": "tsx scripts/db-export.ts",
    "db:import": "tsx scripts/db-import.ts"
