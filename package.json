    "build": "prisma migrate deploy && next build",
    "start": "cross-env PORT=3001 next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "prisma db seed",
