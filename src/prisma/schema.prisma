
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model User {
  id                 String       @id
  name               String
  firstName          String
  lastName           String
  email              String       @unique
  avatar             String?
  phoneNumber        String?
  roles              Role[]       @relation("UserRoles")
  managedProjects    Project[]    @relation("ProjectManager")
  assignedTasks      Task[]       @relation("TaskAssignees")
  taskUpdates        TaskUpdate[] @relation("TaskUpdateAuthor")
  ledTeams           Team[]       @relation("TeamLead")
  teams              Team[]       @relation("TeamMembers")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Department {
  id                       String      @id @default(cuid())
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  projects                 Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String // OPEN, RESOLVED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model Milestone {
  id                     String       @id @default(cuid())
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId              String
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  tasks                  Task[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String
  status      String // TODO, IN_PROGRESS, PENDING_REVIEW, DONE
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]       @relation("TaskAssignees")
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String   @id @default(cuid())
  text      String
  type      String // COMMENT, STATUS_CHANGE
  createdAt DateTime @default(now())
  author    User     @relation("TaskUpdateAuthor", fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
}

model Team {
  id         String  @id @default(cuid())
  name       String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  teamLead   User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]  @relation("TeamMembers")
}

model Setting {
  key   String @id
  value String
}
