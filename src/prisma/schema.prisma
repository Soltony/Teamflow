
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id
  email            String   @unique
  name             String
  firstName        String
  lastName         String
  avatar           String
  phoneNumber      String?

  roles            Role[]       @relation("UserRoles")
  assignedTasks    Task[]       @relation("TaskAssignees")
  projectManager   Project[]
  teamLead         Team[]
  teams            Team[]       @relation("TeamMembers")
  updates          TaskUpdate[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Department {
  id                     String      @id @default(cuid())
  name                   String      @unique
  responsibleName        String
  responsibleTitle       String
  responsiblePhone       String
  projects               Project[]
  responsibleMilestones  Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  statusId         String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId     String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  projectManagerId String
  projectManager   User          @relation(fields: [projectManagerId], references: [id])
  milestones       Milestone[]
  teams            Team[]
  blockers         Blocker[]
}

model Milestone {
  id                     String       @id
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Int
  projectId              String
  project                Project      @relation(fields: [projectId], references: [id])
  tasks                  Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
}

model Task {
  id          String       @id
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestoneId String
  milestone   Milestone    @relation(fields: [milestoneId], references: [id])
  updates     TaskUpdate[]
  assignees   User[]       @relation("TaskAssignees")
}

model TaskUpdate {
  id        String   @id
  text      String
  type      String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
}

model Team {
  id         String  @id
  name       String
  projectId  String
  project    Project @relation(fields: [projectId], references: [id])
  teamLeadId String
  teamLead   User    @relation(fields: [teamLeadId], references: [id])
  members    User[]  @relation("TeamMembers")
}

model Blocker {
  id          String    @id
  description String
  status      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
}

model Setting {
  key   String @id
  value String
}
