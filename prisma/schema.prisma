// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @unique
  name            String
  email           String    @unique
  password        String
  avatar          String?
  phone           String?
  ledTeams        Team[]    @relation("TeamLead")
  teams           Team[]    @relation("TeamMembers")
  managedProjects Project[]
  assignedTasks   Task[]
  taskUpdates     TaskUpdate[]
}

model Team {
  id         String   @id @unique
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
}

model Department {
  id                     String      @id @unique
  name                   String
  responsibleName        String
  responsibleTitle       String
  responsiblePhone       String
  ownedProjects          Project[]
  responsibleMilestones  Milestone[]
}

model ProjectStatus {
  id       String    @id @unique
  name     String
  projects Project[]
}

model Project {
  id                String        @id @unique
  name              String
  description       String
  startDate         DateTime
  endDate           DateTime
  workingYear       String
  status            ProjectStatus @relation(fields: [statusId], references: [id])
  statusId          String
  owningDepartment  Department    @relation(fields: [departmentId], references: [id])
  departmentId      String
  projectManager    User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId  String
  milestones        Milestone[]
  teams             Team[]
  blockers          Blocker[]
}

model Blocker {
  id          String    @id @unique
  description String
  status      BlockerStatus
  createdAt   DateTime
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
}

model Milestone {
  id                     String       @id @unique
  title                  String
  description            String
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id])
  projectId              String
  responsibleDepartments Department[]
  tasks                  Task[]
}

model Task {
  id          String   @id @unique
  title       String
  description String
  status      TaskStatus
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone  @relation(fields: [milestoneId], references: [id])
  milestoneId String
  assignees   User[]
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String   @id @unique
  text      String
  type      TaskUpdateType
  createdAt DateTime
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}
