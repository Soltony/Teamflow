datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  firstName     String
  lastName      String
  email         String    @unique
  avatar        String?
  phoneNumber   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  roles         Role[]    @relation("UserRoles")
  
  managedProjects Project[]    @relation("ProjectManager")
  assignedTasks   Task[]       @relation("TaskAssignees")
  teamsAsLead     Team[]       @relation("TeamLead")
  teamsAsMember   Team[]       @relation("TeamMembers")
  taskUpdates     TaskUpdate[] @relation("UpdateAuthor")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Department {
  id                 String      @id @default(uuid())
  name               String      @unique
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  users              User[]
  ownedProjects      Project[]   @relation("OwningDepartment")
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id @default(uuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  statusId         String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId     String
  owningDepartment Department    @relation("OwningDepartment", fields: [departmentId], references: [id])
  projectManagerId String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Milestone {
  id                     String       @id @default(uuid())
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Int
  projectId              String
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                  Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestoneId String
  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignees   User[]     @relation("TaskAssignees")
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String   @id @default(uuid())
  text      String
  type      String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation("UpdateAuthor", fields: [authorId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Blocker {
  id          String    @id @default(uuid())
  description String
  status      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id         String  @id @default(uuid())
  name       String
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamLeadId String
  teamLead   User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  members    User[]  @relation("Team