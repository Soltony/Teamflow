// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id        String @id @default(cuid())
  name      String
  email     String @unique
  password  String
  avatar    String
  phone     String

  tasks             Task[]       @relation("TaskAssignees")
  ledTeams          Team[]       @relation("TeamLead")
  teams             Team[]       @relation("TeamMembers")
  managedProjects   Project[]    @relation("ProjectManager")
  taskUpdates       TaskUpdate[] @relation("UpdateAuthor")
}

model Department {
  id                        String      @id @default(cuid())
  name                      String      @unique
  responsibleName           String
  responsibleTitle          String
  responsiblePhone          String

  ownedProjects             Project[]   @relation("OwningDepartment")
  responsibleForMilestones  Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  projects  Project[]
}

model Project {
  id                String        @id @default(cuid())
  name              String
  description       String
  startDate         DateTime
  endDate           DateTime
  workingYear       String

  statusId          String
  status            ProjectStatus @relation(fields: [statusId], references: [id])

  departmentId      String
  owningDepartment  Department    @relation("OwningDepartment", fields: [departmentId], references: [id])

  projectManagerId  String
  projectManager    User          @relation("ProjectManager", fields: [projectManagerId], references: [id])

  milestones        Milestone[]
  blockers          Blocker[]
  teams             Team[]
}

model Team {
  id          String   @id @default(cuid())
  name        String

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  teamLeadId  String
  teamLead    User     @relation("TeamLead", fields: [teamLeadId], references: [id])

  members     User[]   @relation("TeamMembers")
}

model Milestone {
  id                      String      @id @default(cuid())
  title                   String
  description             String
  startDate               DateTime
  dueDate                 DateTime
  weight                  Int

  projectId               String
  project                 Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  responsibleDepartments  Department[] @relation("ResponsibleDepartments")
  tasks                   Task[]
}

model Task {
  id            String      @id @default(cuid())
  title         String
  description   String
  status        TaskStatus  @default(TODO)
  startDate     DateTime
  endDate       DateTime
  weight        Int
  completedAt   DateTime?

  milestoneId   String
  milestone     Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  assignees     User[]      @relation("TaskAssignees")
  updates       TaskUpdate[]
}

model Blocker {
  id           String        @id @default(cuid())
  description  String
  status       BlockerStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolution   String?

  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TaskUpdate {
  id        String          @id @default(cuid())
  text      String
  createdAt DateTime        @default(now())
  type      TaskUpdateType

  authorId  String
  author    User            @relation("UpdateAuthor", fields: [authorId], references: [id])

  taskId    String
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}
