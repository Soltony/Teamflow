
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id       String    @id
  name     String
  email    String    @unique
  password String
  avatar   String?
  phone    String?

  tasks           Task[]     @relation("TaskAssignees")
  teams           Team[]     @relation("TeamMembers")
  ledTeams        Team[]     @relation(name: "TeamLeadToUser")
  managedProjects Project[]
  taskUpdates     TaskUpdate[]
}

model Team {
  id   String @id
  name String

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  teamLead   User   @relation(name: "TeamLeadToUser", fields: [teamLeadId], references: [id])
  teamLeadId String

  members User[] @relation("TeamMembers")
}

model Department {
  id                 String      @id
  name               String
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  ownedProjects      Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id
  name     String    @unique
  projects Project[]
}

model Project {
  id          String   @id
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  workingYear String

  status   ProjectStatus @relation(fields: [statusId], references: [id])
  statusId String

  owningDepartment Department @relation(fields: [departmentId], references: [id])
  departmentId     String

  projectManager   User   @relation(fields: [projectManagerId], references: [id])
  projectManagerId String

  milestones Milestone[]
  blockers   Blocker[]
  teams      Team[]
}

model Blocker {
  id          String   @id
  description String
  status      String
  createdAt   DateTime
  resolvedAt  DateTime?
  resolution  String?

  project   Project @relation(fields: [projectId], references: [id])
  projectId String
}

model Milestone {
  id          String   @id
  title       String
  description String
  dueDate     DateTime
  weight      Int

  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  tasks                  Task[]
}

model Task {
  id          String   @id
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?

  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId String

  assignees User[] @relation("TaskAssignees")
  updates   TaskUpdate[]
}

model TaskUpdate {
  id        String   @id
  text      String
  type      String
  createdAt DateTime

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String
}
