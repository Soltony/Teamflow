// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  name          String
  firstName     String
  lastName      String
  email         String       @unique
  avatar        String?
  phoneNumber   String?      @unique
  pmoDivision   PmoDivision? @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId String?
  roles         Role[]       @relation("UserRoles")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  managedProjects Project[]
  teamsLed        Team[]       @relation("TeamLead")
  teams           Team[]       @relation("TeamMembers")
  tasks           Task[]
  updates         TaskUpdate[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model PmoDivision {
  id                 String   @id @default(uuid())
  name               String   @unique
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  users              User[]
  projects           Project[]
}

model Department {
  id                 String     @id @default(uuid())
  name               String     @unique
  projects           Project[]  @relation("ProjectResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id                 String       @id @default(uuid())
  name               String
  description        String
  startDate          DateTime
  endDate            DateTime
  workingYear        String
  status             ProjectStatus @relation(fields: [statusId], references: [id])
  statusId           String
  pmoDivision        PmoDivision  @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId      String
  projectManager     User         @relation(fields: [projectManagerId], references: [id])
  projectManagerId   String
  totalCost          Decimal?
  costByMilestones   Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  milestones         Milestone[]
  teams              Team[]
  blockers           Blocker[]
  responsibleDepartments Department[] @relation("ProjectResponsibleDepartments")
}

model Team {
  id         String   @id @default(uuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
}

model Milestone {
  id          String     @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Int
  cost        Decimal?
  project     Project    @relation(fields: [projectId], references: [id])
  projectId   String
  tasks       Task[]
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String
  status       String     @default("TODO") // e.g., 'TODO', 'IN_PROGRESS', 'PENDING_REVIEW', 'DONE'
  startDate    DateTime
  endDate      DateTime
  completedAt  DateTime?
  weight       Int
  progress     Int        @default(0)
  milestone    Milestone  @relation(fields: [milestoneId], references: [id])
  milestoneId  String
  assignees    User[]
  updates      TaskUpdate[]
}

model TaskUpdate {
  id                 String    @id @default(uuid())
  text               String
  type               String    @default("COMMENT") // 'COMMENT', 'STATUS_CHANGE'
  progressPercentage Int?
  author             User      @relation(fields: [authorId], references: [id])
  authorId           String
  task               Task      @relation(fields: [taskId], references: [id])
  taskId             String
  createdAt          DateTime  @default(now())
}

model Blocker {
  id          String    @id @default(uuid())
  description String
  status      String    @default("OPEN") // 'OPEN' or 'RESOLVED'
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
}

model Setting {
  key   String @id
  value String
}

// Explicit many-to-many join table for Project and Department
model _ProjectToDepartment {
  A String
  B String

  @@unique([A, B])
  @@index([B])
  @@map("ProjectResponsibleDepartments")
}
