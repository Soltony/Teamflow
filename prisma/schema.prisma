
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  password        String
  avatar          String?
  phone           String?
  tasks           Task[]       @relation("TaskAssignees")
  ledTeams        Team[]
  teams           Team[]       @relation("TeamMembers")
  createdUpdates  TaskUpdate[]
  managedProjects Project[]
}

model Department {
  id                       String      @id @default(cuid())
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  projects                 Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Blocker {
  id          String   @id @default(cuid())
  description String
  status      String // OPEN, RESOLVED
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
}

model Milestone {
  id                     String       @id @default(cuid())
  title                  String
  description            String
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id])
  projectId              String
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  tasks                  Task[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String
  status      String // TODO, IN_PROGRESS, PENDING_REVIEW, DONE
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone    @relation(fields: [milestoneId], references: [id])
  milestoneId String
  assignees   User[]       @relation("TaskAssignees")
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String   @id @default(cuid())
  text      String
  type      String   @default("COMMENT") // COMMENT, STATUS_CHANGE
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
}

model Team {
  id         String  @id @default(cuid())
  name       String
  project    Project @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User    @relation(fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]  @relation("TeamMembers")
}
