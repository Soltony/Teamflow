datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String
  firstName   String
  lastName    String
  email       String   @unique
  avatar      String
  phoneNumber String?
  roles       Role[]   @relation("UserRoles")
  projects    Project[]
  assignedTasks Task[]   @relation("TaskAssignees")
  taskUpdates TaskUpdate[]
  ledTeams    Team[]   @relation("TeamLeads")
  teams       Team[]   @relation("TeamMembers")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Project {
  id              String      @id @default(cuid())
  name            String
  description     String
  startDate       DateTime
  endDate         DateTime
  statusId        String
  status          ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId    String
  owningDepartment Department  @relation(fields: [departmentId], references: [id])
  projectManagerId String
  projectManager  User        @relation(fields: [projectManagerId], references: [id])
  milestones      Milestone[]
  blockers        Blocker[]
  teams           Team[]
  workingYear     String
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Department {
  id            String      @id @default(cuid())
  name          String      @unique
  responsibleName String
  responsibleTitle String
  responsiblePhone String
  ownedProjects Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model Milestone {
  id          String       @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Int
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  tasks       Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  weight      Int
  milestoneId String
  milestone   Milestone  @relation(fields: [milestoneId], references: [id])
  assignees   User[]     @relation("TaskAssignees")
  updates     TaskUpdate[]
  completedAt DateTime?
}

model TaskUpdate {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  type      String   @default("COMMENT")
}

model Blocker {
  id          String   @id @default(cuid())
  description String
  status      String
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Team {
  id        String  @id @default(cuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  teamLeadId String
  teamLead  User    @relation("TeamLeads", fields: [teamLeadId], references: [