
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String       @id @default(cuid())
  name            String
  firstName       String
  lastName        String
  email           String       @unique
  avatar          String?
  phoneNumber     String?      @unique
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  roles           Role[]       @relation("UserRoles")
  assignedTasks   Task[]       @relation("TaskAssignees")
  updates         TaskUpdate[]
  ledTeams        Team[]       @relation("TeamLead")
  teams           Team[]       @relation("TeamMembers")
  managedProjects Project[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Department {
  id                    String       @id @default(cuid())
  name                  String       @unique
  responsibleName       String
  responsibleTitle      String
  responsiblePhone      String
  users                 User[]
  ownedProjects         Project[]
  responsibleMilestones Milestone[]  @relation("MilestoneDepartments")
}

model Project {
  id                String         @id @default(cuid())
  name              String
  description       String
  startDate         DateTime
  endDate           DateTime
  workingYear       String
  totalCost         Decimal?
  costByMilestones  Boolean?
  statusId          String
  status            ProjectStatus  @relation(fields: [statusId], references: [id])
  departmentId      String
  owningDepartment  Department     @relation(fields: [departmentId], references: [id])
  projectManagerId  String
  projectManager    User           @relation(fields: [projectManagerId], references: [id])
  milestones        Milestone[]
  blockers          Blocker[]
  teams             Team[]
}

model Milestone {
  id                      String       @id @default(cuid())
  title                   String
  description             String
  startDate               DateTime
  dueDate                 DateTime
  weight                  Float
  cost                    Decimal?
  projectId               String
  project                 Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                   Task[]
  responsibleDepartments  Department[] @relation("MilestoneDepartments")
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String
  status       String
  startDate    DateTime
  endDate      DateTime
  weight       Float
  progress     Float        @default(0)
  completedAt  DateTime?
  milestoneId  String
  milestone    Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignees    User[]       @relation("TaskAssignees")
  updates      TaskUpdate[]
}

model TaskUpdate {
  id                  String   @id @default(cuid())
  text                String
  createdAt           DateTime @default(now())
  authorId            String
  author              User     @relation(fields: [authorId], references: [id])
  taskId              String
  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type                String   @default("COMMENT") // COMMENT, STATUS_CHANGE
  progressPercentage  Int?
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String // OPEN, RESOLVED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id         String   @id @default(cuid())
  name       String
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  teamLeadId String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  members    User[]   @relation("TeamMembers")
}

model Setting {
  key   String @id
  value String
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

    