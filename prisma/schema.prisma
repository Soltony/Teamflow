// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String       @id @default(uuid())
  name      String
  email     String       @unique
  password  String
  avatar    String?
  phone     String?
  tasks     Task[]       @relation("TaskAssignees")
  ledTeams  Team[]
  teams     Team[]       @relation("TeamMembers")
  updates   TaskUpdate[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id                      String      @id @default(uuid())
  name                    String      @unique
  responsibleName         String
  responsibleTitle        String
  responsiblePhone        String
  projects                Project[]
  responsibleForMilestone Milestone[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
}

model ProjectStatus {
  id        String    @id @default(uuid())
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id               String        @id @default(uuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Blocker {
  id          String    @id @default(uuid())
  description String
  status      String // BlockerStatus
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  updatedAt   DateTime  @updatedAt
}

model Milestone {
  id                     String       @id @default(uuid())
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Float
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId              String
  tasks                  Task[]
  responsibleDepartments Department[]
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String
  status      String // TaskStatus
  startDate   DateTime
  endDate     DateTime
  weight      Float
  completedAt DateTime?
  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]       @relation("TaskAssignees")
  updates     TaskUpdate[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TaskUpdate {
  id        String   @id @default(uuid())
  text      String
  type      String // TaskUpdateType
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id         String   @id @default(uuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  teamLead   User     @relation(fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
