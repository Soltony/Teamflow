
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  // Using a specific debian openssl version to ensure compatibility
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// Models based on src/lib/types.ts and prisma/seed.ts

model User {
  id              String       @id
  name            String
  email           String       @unique
  password        String
  avatar          String?
  phone           String?
  managedProjects Project[]    @relation("ProjectManager")
  ledTeams        Team[]       @relation("TeamLead")
  teams           Team[]       @relation(name: "TeamMembers")
  assignedTasks   Task[]       @relation(name: "TaskAssignees")
  taskUpdates     TaskUpdate[]
}

model Department {
  id                       String      @id
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  projects                 Project[]
  responsibleForMilestones Milestone[] @relation(name: "ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Milestone {
  id          String       @id
  title       String
  description String
  dueDate     DateTime
  weight      Int
  project     Project      @relation(fields: [projectId], references: [id])
  projectId   String
  tasks       Task[]
  responsibleDepartments Department[] @relation(name: "ResponsibleDepartments")
}

model Task {
  id          String       @id
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone    @relation(fields: [milestoneId], references: [id])
  milestoneId String
  updates     TaskUpdate[]
  assignees   User[]       @relation(name: "TaskAssignees")
}

model TaskUpdate {
  id        String   @id
  text      String
  type      String
  createdAt DateTime
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
}

model Blocker {
  id          String    @id
  description String
  status      String
  createdAt   DateTime
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
}

model Team {
  id         String  @id
  name       String
  project    Project @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]  @relation(name: "TeamMembers")
}
