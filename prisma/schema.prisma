
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(cuid())
  name            String
  firstName       String
  lastName        String
  email           String         @unique
  avatar          String?
  phoneNumber     String?
  pmoDivisionId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  roles           Role[]         @relation("UserRoles")
  pmoDivision     PmoDivision?   @relation(fields: [pmoDivisionId], references: [id])
  tasks           Task[]         @relation("TaskAssignees")
  teams           Team[]         @relation("TeamMembers")
  ledTeams        Team[]         @relation("TeamLeads")
  taskUpdates     TaskUpdate[]
  managedProjects Project[]      @relation("ManagedProjects")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model PmoDivision {
  id               String    @id @default(cuid())
  name             String    @unique
  responsibleName  String
  responsibleTitle String
  responsiblePhone String
  users            User[]
  projects         Project[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  name        String    @unique
  projects    Project[] @relation("ProjectResponsibleDepartments")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id               String       @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  statusId         String
  pmoDivisionId    String
  projectManagerId String
  totalCost        Decimal?
  costByMilestones Boolean?     @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  status                  ProjectStatus @relation(fields: [statusId], references: [id])
  pmoDivision             PmoDivision   @relation(fields: [pmoDivisionId], references: [id])
  projectManager          User          @relation("ManagedProjects", fields: [projectManagerId], references: [id])
  responsibleDepartments  Department[]  @relation("ProjectResponsibleDepartments")
  
  milestones       Milestone[]
  teams            Team[]
  blockers         Blocker[]
}

model ProjectStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  projects  Project[]
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Float
  projectId   String
  cost        Decimal?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks    Task[]
  payments MilestonePayment[]
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String
  status       String
  startDate    DateTime
  endDate      DateTime
  weight       Int
  progress     Int         @default(0)
  completedAt  DateTime?
  milestoneId  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  milestone    Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignees    User[]      @relation("TaskAssignees")
  updates      TaskUpdate[]
}

model TaskUpdate {
    id        String @id @default(cuid())
    text      String
    authorId  String
    taskId    String
    type      String // e.g., 'COMMENT', 'STATUS_CHANGE'
    progressPercentage Int?
    createdAt DateTime @default(now())

    author User @relation(fields: [authorId], references: [id])
    task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Team {
  id         String   @id @default(cuid())
  name       String
  projectId  String
  teamLeadId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamLead User    @relation("TeamLeads", fields: [teamLeadId], references: [id])
  members  User[]  @relation("TeamMembers")
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String    // e.g., 'OPEN', 'RESOLVED'
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MilestonePayment {
  id          String   @id @default(cuid())
  milestoneId String
  amount      Decimal
  paymentDate DateTime
  status      String   // PENDING, APPROVED, REJECTED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
