// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id
  name             String
  firstName        String?
  lastName         String?
  email            String      @unique
  avatar           String?
  phoneNumber      String?
  
  // Relations
  managedProjects Project[] @relation("ProjectManager")
  assignedTasks   Task[]    @relation("TaskAssignees")
  teamsAsLead     Team[]    @relation("TeamLead")
  teamsAsMember   Team[]    @relation("TeamMembers")
  taskUpdates     TaskUpdate[]
}

model Department {
  id                  String   @id @default(cuid())
  name                String   @unique
  responsibleName     String
  responsibleTitle    String
  responsiblePhone    String

  // Relations
  projects                Project[]    @relation("OwningDepartment")
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id    String @id @default(cuid())
  name  String @unique
  
  // Relations
  projects Project[]
}

model Project {
  id                String   @id @default(cuid())
  name              String
  description       String
  startDate         DateTime
  endDate           DateTime
  workingYear       String

  // Relations
  status            ProjectStatus @relation(fields: [statusId], references: [id])
  statusId          String

  owningDepartment  Department @relation("OwningDepartment", fields: [departmentId], references: [id])
  departmentId      String

  projectManager    User @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId  String

  milestones        Milestone[]
  blockers          Blocker[]
  teams             Team[]
}

model Milestone {
  id              String   @id @default(cuid())
  title           String
  description     String
  startDate       DateTime
  dueDate         DateTime
  weight          Int

  // Relations
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  tasks           Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String
  status      String // "TODO", "IN_PROGRESS", "PENDING_REVIEW", "DONE"
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?

  // Relations
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]    @relation("TaskAssignees")
  updates     TaskUpdate[]
}

model TaskUpdate {
  id          String   @id @default(cuid())
  text        String
  type        String // 'COMMENT', 'STATUS_CHANGE'
  createdAt   DateTime @default(now())

  // Relations
  author      User     @relation(fields: [authorId], references: [id])
  authorId    String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String // "OPEN", "RESOLVED"
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  
  // Relations
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model Team {
  id          String @id @default(cuid())
  name        String
  
  // Relations
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  teamLead    User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId  String
  members     User[]  @relation("TeamMembers")
}

model Setting {
  key   String @id
  value String
}
