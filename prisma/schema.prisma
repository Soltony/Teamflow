// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  firstName     String
  lastName      String
  email         String    @unique
  avatar        String?
  phoneNumber   String?
  pmoDivisionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles       Role[]
  pmoDivision PmoDivision? @relation(fields: [pmoDivisionId], references: [id])
  projects    Project[]
  teamsLed    Team[]       @relation("TeamLead")
  teams       Team[]       @relation("TeamMembers")
  updates     TaskUpdate[]
  tasks       Task[]       @relation("TaskAssignees")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id                 String   @id @default(cuid())
  name               String
  description        String
  startDate          DateTime
  endDate            DateTime
  workingYear        String
  statusId           String
  pmoDivisionId      String
  projectManagerId   String
  totalCost          Decimal?
  costByMilestones   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  status               ProjectStatus   @relation(fields: [statusId], references: [id])
  pmoDivision          PmoDivision     @relation(fields: [pmoDivisionId], references: [id])
  projectManager       User            @relation(fields: [projectManagerId], references: [id])
  milestones         Milestone[]
  teams              Team[]
  blockers           Blocker[]
  responsibleDepartments Department[] @relation("ProjectResponsibleDepartments")
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Float
  cost        Decimal?
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String
  status       String     @default("TODO")
  startDate    DateTime
  endDate      DateTime
  weight       Float
  progress     Float      @default(0)
  completedAt  DateTime?
  milestoneId  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  milestone Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  updates   TaskUpdate[]
  assignees User[]       @relation("TaskAssignees")
}

model TaskUpdate {
  id                 String   @id @default(cuid())
  text               String
  authorId           String
  taskId             String
  type               String
  progressPercentage Float?
  createdAt          DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Team {
  id         String   @id @default(cuid())
  name       String
  projectId  String
  teamLeadId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamLead User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  members  User[]  @relation("TeamMembers")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model PmoDivision {
  id                 String   @id @default(cuid())
  name               String   @unique
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  projects Project[]
  users    User[]
}

model Department {
  id                 String   @id @default(cuid())
  name               String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  projects           Project[] @relation("ProjectResponsibleDepartments")
}

model Setting {
  key   String @id
  value String
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
