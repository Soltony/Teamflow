
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  avatar    String
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tasks     Task[]    @relation("Assignees")
  projects  Project[]
  teamsLed  Team[]    @relation("TeamLead")
  teams     Team[]    @relation("TeamMembers")
  updates   TaskUpdate[]
}

model Department {
  id                      String    @id @default(cuid())
  name                    String    @unique
  responsibleName         String
  responsibleTitle        String
  responsiblePhone        String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  projects                Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id              String         @id @default(cuid())
  name            String
  description     String
  startDate       DateTime
  endDate         DateTime
  workingYear     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  status          ProjectStatus  @relation(fields: [statusId], references: [id])
  statusId        String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId    String
  projectManager  User           @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones      Milestone[]
  blockers        Blocker[]
  teams           Team[]
}

model Milestone {
  id                      String       @id @default(cuid())
  title                   String
  description             String
  startDate               DateTime
  dueDate                 DateTime
  weight                  Int
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  project                 Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId               String
  responsibleDepartments  Department[] @relation("ResponsibleDepartments")
  tasks                   Task[]
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String
  status      TaskStatus  @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  milestone   Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]      @relation("Assignees")
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String      @id @default(cuid())
  text      String
  type      UpdateType  @default(COMMENT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  author    User        @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
}

model Blocker {
  id          String         @id @default(cuid())
  description String
  status      BlockerStatus  @default(OPEN)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  resolution  String?
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model Team {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  teamLead    User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId  String
  members     User[]   @relation("TeamMembers")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum UpdateType {
  COMMENT
  STATUS_CHANGE
}

enum BlockerStatus {
  OPEN
  RESOLVED
}
