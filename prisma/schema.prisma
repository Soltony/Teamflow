// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  userId           String      @unique @default(cuid())
  email            String      @unique
  name             String
  firstName        String?
  lastName         String?
  password         String
  avatar           String?
  phoneNumber      String?
  roles            Role[]      @relation("UserRoles")
  managedBuildings Building[]  @relation("ManagedBuildings")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt

  teams            Team[]      @relation("TeamMembers")
  ledTeams         Team[]      @relation("TeamLead")
  tasks            Task[]      @relation("TaskAssignees")
  updates          TaskUpdate[]
  projectManagerOf Project[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Building {
  id          String @id @default(cuid())
  name        String
  address     String?
  managers    User[] @relation("ManagedBuildings")
}

model Department {
  id                 String      @id @default(cuid())
  name               String      @unique
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  projects           Project[]
  milestones         Milestone[] @relation("ResponsibleDepartments")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  teamLead  User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members   User[]   @relation("TeamMembers")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String      @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department  @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User        @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  teams            Team[]
  blockers         Blocker[]
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Int
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  tasks       Task[]

  responsibleDepartments Department[] @relation("ResponsibleDepartments")
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  weight      Int
  milestone   Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]      @relation("TaskAssignees")
  updates     TaskUpdate[]
  completedAt DateTime?
}

model TaskUpdate {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  type      String   // e.g., 'COMMENT', 'STATUS_CHANGE'
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String    // e.g., 'OPEN', 'RESOLVED'
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model Setting {
  key   String @id
  value String
}
