
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String  @id @default(uuid())
  name          String
  firstName     String
  lastName      String
  email         String  @unique
  avatar        String?
  phoneNumber   String?
  pmoDivision   PmoDivision? @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId String?

  roles         Role[]  @relation("UserRoles")
  assignedTasks Task[]  @relation("TaskAssignees")
  teams         Team[]  @relation("TeamMembers")
  teamLeadOf    Team[]  @relation("TeamLead")
  managedProjects Project[]
  taskUpdates   TaskUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PmoDivision {
  id                String   @id @default(uuid())
  name              String   @unique
  responsibleName   String
  responsibleTitle  String
  responsiblePhone  String
  users             User[]
  projects          Project[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Department {
  id                  String      @id @default(uuid())
  name                String      @unique
  responsibleMilestones Milestone[] @relation("ResponsibleDepartments")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Project {
  id                String        @id @default(uuid())
  name              String
  description       String
  startDate         DateTime
  endDate           DateTime
  workingYear       String
  status            ProjectStatus @relation(fields: [statusId], references: [id])
  statusId          String
  pmoDivision       PmoDivision   @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId     String
  projectManager    User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId  String
  milestones        Milestone[]
  teams             Team[]
  blockers          Blocker[]
  totalCost         Decimal?
  costByMilestones  Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model ProjectStatus {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}

model Milestone {
  id          String       @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Int
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  tasks       Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  cost        Decimal?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Task {
  id           String      @id @default(uuid())
  title        String
  description  String
  status       String
  startDate    DateTime
  endDate      DateTime
  weight       Int
  progress     Int         @default(0)
  completedAt  DateTime?
  milestone    Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId  String
  assignees    User[]      @relation("TaskAssignees")
  updates      TaskUpdate[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model TaskUpdate {
  id                 String   @id @default(uuid())
  text               String
  type               String
  progressPercentage Int?
  author             User     @relation(fields: [authorId], references: [id])
  authorId           String
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId             String
  createdAt          DateTime @default(now())
}

model Team {
  id         String   @id @default(uuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Blocker {
  id          String    @id @default(uuid())
  description String
  status      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

    