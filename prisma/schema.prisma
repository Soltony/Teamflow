// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  password        String
  avatar          String?
  phone           String?
  ledTeams        Team[]    @relation("TeamLead")
  teams           Team[]    @relation("TeamMembers")
  managedProjects Project[]
  assignedTasks   Task[]
  taskUpdates     TaskUpdate[]
}

model Team {
  id         String   @id
  name       String
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  teamLeadId String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  memberIds  String[]
  members    User[]   @relation("TeamMembers")
}

model TaskUpdate {
  id        String   @id
  text      String
  userId    String
  author    User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  type      UpdateType @default(COMMENT)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
}

model Task {
  id          String     @id
  title       String
  description String
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestoneId String
  milestone   Milestone  @relation(fields: [milestoneId], references: [id])
  assignees   User[]
  updates     TaskUpdate[]
}

model Milestone {
  id                       String       @id
  title                    String
  description              String
  dueDate                  DateTime
  weight                   Int
  projectId                String
  project                  Project      @relation(fields: [projectId], references: [id])
  responsibleDepartmentIds String[]
  responsibleDepartments   Department[]
  tasks                    Task[]
}

model Department {
  id                       String      @id
  name                     String
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  ownedProjects            Project[]
  responsibleForMilestones Milestone[]
}

model ProjectStatus {
  id       String    @id
  name     String
  projects Project[]
}

model Blocker {
  id          String   @id
  description String
  status      BlockerStatus @default(OPEN)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
}

model Project {
  id               String   @id
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  statusId         String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId     String
  owningDepartment Department @relation(fields: [departmentId], references: [id])
  projectManagerId String
  projectManager   User     @relation(fields: [projectManagerId], references: [id])
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum UpdateType {
  COMMENT
  STATUS_CHANGE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}
