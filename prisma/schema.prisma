
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String      @id
  name             String
  firstName        String
  lastName         String
  email            String      @unique
  avatar           String?
  phoneNumber      String?
  roles            Role[]      @relation("UserRoles")
  managedProjects  Project[]
  tasks            Task[]
  taskUpdates      TaskUpdate[]
  ledTeams         Team[]      @relation("TeamLead")
  teams            Team[]      @relation("TeamMembers")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Team {
    id        String   @id @default(cuid())
    name      String
    projectId String
    project   Project  @relation(fields: [projectId], references: [id])
    teamLeadId String
    teamLead  User     @relation("TeamLead", fields: [teamLeadId], references: [id])
    members   User[]   @relation("TeamMembers")
}

model Project {
  id               String      @id
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  statusId         String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId     String
  owningDepartment Department  @relation(fields: [departmentId], references: [id])
  projectManagerId String
  projectManager   User        @relation(fields: [projectManagerId], references: [id])
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Department {
  id                      String       @id @default(cuid())
  name                    String       @unique
  responsibleName         String
  responsibleTitle        String
  responsiblePhone        String
  projects                Project[]
  responsibleForMilestones Milestone[]
}

model Milestone {
  id                      String       @id
  title                   String
  description             String
  startDate               DateTime
  dueDate                 DateTime
  weight                  Int
  projectId               String
  project                 Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                   Task[]
  responsibleDepartments  Department[]
}

model Task {
  id          String       @id
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  completedAt DateTime?
  weight      Int
  milestoneId String
  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignees   User[]
  updates     TaskUpdate[]
}

model TaskUpdate {
    id        String   @id @default(cuid())
    text      String
    type      String
    createdAt DateTime @default(now())
    authorId  String
    author    User     @relation(fields: [authorId], references: [id])
    taskId    String
    task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Blocker {
    id          String   @id @default(cuid())
    description String
    status      String
    createdAt   DateTime @default(now())
    resolvedAt  DateTime?
    resolution  String?
    projectId   String
    project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id
  value String
}
