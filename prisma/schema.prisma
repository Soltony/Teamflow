
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String       @id
  name            String
  email           String       @unique
  password        String
  avatar          String?
  phone           String?
  managedProjects Project[]    @relation("ProjectManager")
  assignedTasks   Task[]       @relation("TaskAssignees")
  taskUpdates     TaskUpdate[]
  ledTeams        Team[]       @relation("TeamLead")
  teams           Team[]       @relation("TeamMembers")
}

model Department {
  id                       String      @id @default(uuid())
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  ownedProjects            Project[]   @relation("OwningDepartment")
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation("OwningDepartment", fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Milestone {
  id                     String       @id
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId              String
  tasks                  Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
}

model Task {
  id          String       @id
  title       String
  description String
  status      String
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]       @relation("TaskAssignees")
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String   @id
  text      String
  type      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
}

model Blocker {
  id          String    @id
  description String
  status      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model Team {
  id         String  @id
  name       String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  teamLead   User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]  @relation("TeamMembers")
}

model Setting {
  key   String @id @unique
  value String
}
