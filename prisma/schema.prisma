generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @unique
  name            String
  email           String    @unique
  password        String
  avatar          String?
  phone           String?
  ledTeams        Team[]    @relation("TeamLead")
  teams           Team[]    @relation("TeamMembers")
  managedProjects Project[] @relation("ProjectManager")
  assignedTasks   Task[]
  taskUpdates     TaskUpdate[]

  @@map("users")
}

model Team {
  id         String   @id @unique
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")

  @@map("teams")
}

model Department {
  id                 String      @id @unique
  name               String
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  ownedProjects      Project[]   @relation("OwningDepartment")
  milestones         Milestone[]

  @@map("departments")
}

model ProjectStatus {
  id       String    @id @unique
  name     String    @unique
  projects Project[]

  @@map("project_statuses")
}

model Blocker {
  id          String    @id @unique
  description String
  status      BlockerStatus
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String

  @@map("blockers")
}

model Project {
  id                 String        @id @unique
  name               String
  description        String
  startDate          DateTime
  endDate            DateTime
  workingYear        String
  status             ProjectStatus @relation(fields: [statusId], references: [id])
  statusId           String
  owningDepartment   Department    @relation("OwningDepartment", fields: [departmentId], references: [id])
  departmentId       String
  projectManager     User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId   String
  milestones         Milestone[]
  blockers           Blocker[]
  teams              Team[]

  @@map("projects")
}

model Milestone {
  id                     String       @id @unique
  title                  String
  description            String
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id])
  projectId              String
  responsibleDepartments Department[]
  tasks                  Task[]

  @@map("milestones")
}

model Task {
  id            String       @id @unique
  title         String
  description   String
  status        TaskStatus
  startDate     DateTime
  endDate       DateTime
  weight        Int
  completedAt   DateTime?
  milestone     Milestone    @relation(fields: [milestoneId], references: [id])
  milestoneId   String
  assignees     User[]
  updates       TaskUpdate[]

  @@map("tasks")
}

model TaskUpdate {
  id        String   @id @unique
  text      String
  type      TaskUpdateType
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String

  @@map("task_updates")
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}
