// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Models from here

model User {
  id               String        @id @default(uuid())
  name             String
  email            String        @unique
  password         String
  avatar           String?
  phone            String?
  projectsAsLeader Project[]
  tasks            Task[]        @relation("TaskAssignees")
  teamsAsLead      Team[]        @relation("TeamLead")
  teamsAsMember    Team[]        @relation("TeamMembers")
  taskUpdates      TaskUpdate[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Department {
  id                       String      @id @default(uuid())
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  projects                 Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
}

model ProjectStatus {
  id        String    @id @default(uuid())
  name      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id               String        @id @default(uuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  teams            Team[]
  blockers         Blocker[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Team {
  id         String   @id @default(uuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Milestone {
  id                     String       @id @default(uuid())
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id])
  projectId              String
  tasks                  Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Int
  milestone   Milestone  @relation(fields: [milestoneId], references: [id])
  milestoneId String
  assignees   User[]     @relation("TaskAssignees")
  updates     TaskUpdate[]
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

model TaskUpdate {
  id        String         @id @default(uuid())
  text      String
  type      TaskUpdateType @default(COMMENT)
  author    User           @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task           @relation(fields: [taskId], references: [id])
  taskId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}

model Blocker {
  id          String        @id @default(uuid())
  description String
  status      BlockerStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project       @relation(fields: [projectId], references: [id])
  projectId   String
  updatedAt   DateTime      @updatedAt
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
