// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  firstName     String
  lastName      String
  email         String    @unique
  avatar        String?
  phoneNumber   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  roles         Role[]
  department    Department? @relation(fields: [departmentId], references: [id])
  departmentId  String?
  pmoDivision   PmoDivision? @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId String?
  managedProjects Project[]
  assignedTasks Task[]      @relation("TaskAssignees")
  taskUpdates   TaskUpdate[]
  ledTeams      Team[]      @relation("TeamLead")
  teams         Team[]      @relation("TeamMembers")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]
}

model PmoDivision {
  id                       String      @id @default(cuid())
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  owningProjects           Project[]   @relation("OwningPmoDivision")
  responsibleForMilestones Milestone[] @relation("ResponsiblePmoDivisions")
  users                    User[]
}

model Department {
  id                       String      @id @default(cuid())
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
}

model Project {
  id                String         @id @default(cuid())
  name              String
  description       String
  startDate         DateTime
  endDate           DateTime
  workingYear       String
  status            ProjectStatus  @relation(fields: [statusId], references: [id])
  statusId          String
  pmoDivision       PmoDivision    @relation("OwningPmoDivision", fields: [pmoDivisionId], references: [id])
  pmoDivisionId     String
  projectManager    User           @relation(fields: [projectManagerId], references: [id])
  projectManagerId  String
  totalCost         Decimal?
  costByMilestones  Boolean        @default(false)
  milestones        Milestone[]
  blockers          Blocker[]
  teams             Team[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Milestone {
  id                       String        @id @default(cuid())
  title                    String
  description              String
  startDate                DateTime
  dueDate                  DateTime
  weight                   Int
  cost                     Decimal?
  project                  Project       @relation(fields: [projectId], references: [id])
  projectId                String
  tasks                    Task[]
  responsiblePmoDivisions  PmoDivision[] @relation("ResponsiblePmoDivisions")
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String
  status        String
  startDate     DateTime
  endDate       DateTime
  completedAt   DateTime?
  weight        Int
  progress      Int          @default(0)
  milestone     Milestone    @relation(fields: [milestoneId], references: [id])
  milestoneId   String
  assignees     User[]       @relation("TaskAssignees")
  updates       TaskUpdate[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TaskUpdate {
  id                 String    @id @default(cuid())
  text               String
  type               String // COMMENT, STATUS_CHANGE
  progressPercentage Int?
  author             User      @relation(fields: [authorId], references: [id])
  authorId           String
  task               Task      @relation(fields: [taskId], references: [id])
  taskId             String
  createdAt          DateTime  @default(now())
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String // OPEN, RESOLVED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
}

model Team {
  id         String   @id @default(cuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
