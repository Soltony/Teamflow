// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums based on the data types in the application
enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}


model User {
  id              String    @id
  name            String
  email           String    @unique
  password        String
  avatar          String?
  phone           String?
  
  ledTeams        Team[]    @relation("TeamLead")
  teams           Team[]    @relation("TeamMembers")
  managedProjects Project[] @relation("ProjectManager")
  assignedTasks   Task[]    @relation("TaskAssignees")
  taskUpdates     TaskUpdate[]
}

model Department {
  id                    String      @id
  name                  String      @unique
  responsibleName       String
  responsibleTitle      String
  responsiblePhone      String
  
  owningProjects        Project[]
  responsibleMilestones Milestone[]
}

model ProjectStatus {
  id       String    @id
  name     String    @unique
  projects Project[]
}

model Project {
  id               String   @id
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  
  statusId         String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  
  departmentId     String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  
  projectManagerId String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Milestone {
  id          String   @id
  title       String
  description String
  dueDate     DateTime
  weight      Int
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  responsibleDepartmentIds String[]
  responsibleDepartments   Department[]
  
  tasks       Task[]
}

model Task {
  id          String     @id
  title       String
  description String
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  
  milestoneId String
  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  
  assignedUserIds String[]
  assignees       User[]   @relation("TaskAssignees")
  
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String         @id
  text      String
  createdAt DateTime       @default(now())
  type      TaskUpdateType
  
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  
  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Blocker {
  id          String        @id
  description String
  status      BlockerStatus @default(OPEN)
  createdAt   DateTime
  resolvedAt  DateTime?
  resolution  String?
  
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id         String @id
  name       String
  
  projectId  String
  project    Project @relation(fields: [projectId], references: [id])
  
  teamLeadId String
  teamLead   User   @relation("TeamLead", fields: [teamLeadId], references: [id])
  
  memberIds  String[]
  members    User[]   @relation("TeamMembers")
}
