generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedProjects Project[]
  tasks           Task[]    @relation("TaskAssignees")
  teams           Team[]    @relation("TeamMembers")
  ledTeams        Team[]    @relation("TeamLeads")
  updates         TaskUpdate[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  workingYear String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  status          ProjectStatus @relation(fields: [statusId], references: [id])
  statusId        String
  owningDepartment Department   @relation(fields: [departmentId], references: [id])
  departmentId    String
  projectManager  User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId String

  milestones Milestone[]
  blockers   Blocker[]
  teams      Team[]
}

model Department {
  id               String      @id @default(cuid())
  name             String      @unique
  responsibleName  String
  responsibleTitle String
  responsiblePhone String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  projects             Project[]
  responsibleMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id     String    @id @default(cuid())
  name   String    @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  tasks                  Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus
  startDate   DateTime
  endDate     DateTime
  weight      Float
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]    @relation("TaskAssignees")
  updates     TaskUpdate[]
}

model Blocker {
  id          String        @id @default(cuid())
  description String
  status      BlockerStatus
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolution  String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model TaskUpdate {
  id        String         @id @default(cuid())
  text      String
  type      TaskUpdateType
  createdAt DateTime       @default(now())

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
}

model Team {
  id      String @id @default(cuid())
  name    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  teamLead  User    @relation("TeamLeads", fields: [teamLeadId], references: [id])
  teamLeadId String
  members   User[]  @relation("TeamMembers")
}

model Setting {
  key   String @id
  value String
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}
