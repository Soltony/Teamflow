// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  password         String
  avatar           String?
  phone            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  managedProjects  Project[]     @relation("ProjectManager")
  teamsAsLead      Team[]        @relation("TeamLead")
  teamsAsMember    Team[]
  tasksAsAssignee  Task[]
  taskUpdates      TaskUpdate[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamLeadId String
  teamLead  User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  members   User[]
}

model Department {
  id                        String      @id @default(cuid())
  name                      String      @unique
  responsibleName           String
  responsibleTitle          String
  responsiblePhone          String
  ownedProjects             Project[]   @relation("OwningDepartment")
  responsibleForMilestones  Milestone[]
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id                String        @id @default(cuid())
  name              String
  description       String
  startDate         DateTime
  endDate           DateTime
  workingYear       String
  statusId          String
  status            ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId      String
  owningDepartment  Department    @relation("OwningDepartment", fields: [departmentId], references: [id])
  projectManagerId  String
  projectManager    User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  milestones        Milestone[]
  teams             Team[]
  blockers          Blocker[]
}

model Milestone {
  id                      String       @id @default(cuid())
  title                   String
  description             String
  startDate               DateTime
  dueDate                 DateTime
  weight                  Int
  projectId               String
  project                 Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsibleDepartments  Department[]
  tasks                   Task[]
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String
  status      TaskStatus  @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestoneId String
  milestone   Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignees   User[]
  updates     TaskUpdate[]
}

model TaskUpdate {
  id        String         @id @default(cuid())
  text      String
  type      TaskUpdateType @default(COMMENT)
  createdAt DateTime       @default(now())
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Blocker {
  id          String         @id @default(cuid())
  description String
  status      BlockerStatus  @default(OPEN)
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}
