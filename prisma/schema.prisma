// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  password        String
  avatar          String?
  phone           String?
  tasks           Task[]       @relation("TaskAssignees")
  taskUpdates     TaskUpdate[]
  managedProjects Project[]
  teams           Team[]       @relation("TeamMembers")
  ledTeams        Team[]       @relation("TeamLead")

  @@map("users")
}

model Department {
  id                       String      @id @default(cuid())
  name                     String      @unique
  responsibleName          String
  responsibleTitle         String
  responsiblePhone         String
  projects                 Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")

  @@map("departments")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]

  @@map("project_statuses")
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]

  @@map("projects")
}

model Milestone {
  id                     String       @id @default(cuid())
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId              String
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  tasks                  Task[]

  @@map("milestones")
}

model Blocker {
  id          String   @id @default(cuid())
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  @@map("blockers")
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String
  status      String       @default("TODO")
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]       @relation("TaskAssignees")
  updates     TaskUpdate[]

  @@map("tasks")
}

model TaskUpdate {
  id        String   @id @default(cuid())
  text      String
  type      String   @default("COMMENT")
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String

  @@map("task_updates")
}

model Team {
  id         String   @id @default(cuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")

  @@map("teams")
}
