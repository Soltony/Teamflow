// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  name          String
  firstName     String
  lastName      String
  email         String        @unique
  avatar        String?
  phoneNumber   String?
  pmoDivision   Department?   @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId String?
  roles         Role[]        @relation("UserRoles")
  teams         Team[]        @relation("TeamMembers")
  teamLeads     Team[]        @relation("TeamLeads")
  tasks         Task[]        @relation("TaskAssignees")
  taskUpdates   TaskUpdate[]
  projects      Project[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

// Owning department for a project (e.g., Marketing, Technology)
model Department {
  id                  String    @id @default(uuid())
  name                String    @unique
  responsibleName     String
  responsibleTitle    String
  responsiblePhone    String
  users               User[]
  projects            Project[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// Receiving department for a milestone's outcome (e.g., Finance, HR)
model PmoDivision {
  id          String     @id @default(uuid())
  name        String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  projects    Project[]  @relation("ProjectResponsibleDepartments")
}

model ProjectStatus {
  id        String    @id @default(uuid())
  name      String    @unique
  projects  Project[]
}

model Project {
  id                       String        @id @default(uuid())
  name                     String
  description              String
  startDate                DateTime
  endDate                  DateTime
  workingYear              String
  status                   ProjectStatus @relation(fields: [statusId], references: [id])
  statusId                 String
  pmoDivision              Department    @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId            String
  projectManager           User          @relation(fields: [projectManagerId], references: [id])
  projectManagerId         String
  totalCost                Decimal?      @db.Decimal(12, 2)
  costByMilestones         Boolean       @default(false)
  responsibleDepartments   PmoDivision[] @relation("ProjectResponsibleDepartments")
  milestones               Milestone[]
  teams                    Team[]
  blockers                 Blocker[]
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
}

model Milestone {
  id            String             @id @default(uuid())
  title         String
  description   String
  startDate     DateTime
  dueDate       DateTime
  weight        Int
  cost          Decimal?           @db.Decimal(12, 2)
  project       Project            @relation(fields: [projectId], references: [id])
  projectId     String
  tasks         Task[]
  payments      MilestonePayment[]
}

model MilestonePayment {
  id            String   @id @default(uuid())
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime
  milestone     Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId   String
  createdAt     DateTime @default(now())
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String
  status        String       @default("TODO") // TODO, IN_PROGRESS, PENDING_REVIEW, DONE
  startDate     DateTime
  endDate       DateTime
  weight        Int
  progress      Int          @default(0)
  completedAt   DateTime?
  milestone     Milestone    @relation(fields: [milestoneId], references: [id])
  milestoneId   String
  assignees     User[]       @relation("TaskAssignees")
  updates       TaskUpdate[]
}

model TaskUpdate {
  id                  String    @id @default(uuid())
  text                String
  type                String    @default("COMMENT") // COMMENT, STATUS_CHANGE
  progressPercentage  Int?
  author              User      @relation(fields: [authorId], references: [id])
  authorId            String
  task                Task      @relation(fields: [taskId], references: [id])
  taskId              String
  createdAt           DateTime  @default(now())
}

model Team {
  id         String   @id @default(uuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLeads", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
}

model Blocker {
  id          String    @id @default(uuid())
  description String
  status      String    @default("OPEN") // OPEN, RESOLVED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
}

model Setting {
  key       String @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
