// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedProjects Project[] @relation("ProjectManager")
  assignedTasks   Task[]
  ledTeams        Team[]      @relation("TeamLead")
  teams           Team[]      @relation("TeamMembers")
  taskUpdates     TaskUpdate[]
}

model Department {
  id                 String   @id @default(cuid())
  name               String   @unique
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  ownedProjects      Project[] @relation("OwningDepartment")
  responsibleForMilestones Milestone[]
}

model ProjectStatus {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  projects  Project[]
}

model Project {
  id               String   @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  
  owningDepartment Department @relation("OwningDepartment", fields: [departmentId], references: [id])
  departmentId     String
  
  projectManager   User     @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId String
  
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Milestone {
  id                      String     @id @default(cuid())
  title                   String
  description             String
  startDate               DateTime
  dueDate                 DateTime
  weight                  Int // Percentage weight
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  project                 Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId               String
  
  responsibleDepartments  Department[]
  tasks                   Task[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      String     // e.g., 'TODO', 'IN_PROGRESS', 'DONE'
  startDate   DateTime
  endDate     DateTime
  weight      Int        // Percentage weight within the milestone
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  
  assignees   User[]
  updates     TaskUpdate[]
}

model TaskUpdate {
  id         String   @id @default(cuid())
  text       String
  type       String   // e.g., 'COMMENT', 'STATUS_CHANGE'
  createdAt  DateTime @default(now())

  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
}

model Blocker {
  id          String   @id @default(cuid())
  description String
  status      String   // e.g., 'OPEN', 'RESOLVED'
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolution  String?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String

  teamLead    User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId  String
  
  members     User[]   @relation("TeamMembers")
}


model Setting {
  key       String @unique
  value     String
  
  @@id([key])
}
