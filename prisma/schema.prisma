
datasource db {
  provider     = "sqlite"
  url          = "file:./dev.db"
  relationMode = "prisma"
}

generator client {
  provider      = "prisma-client-js"
  // Using a bundled openssl version to avoid system dependency issues
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id        String @id @default(cuid())
  name      String
  email     String @unique
  password  String
  avatar    String?
  phone     String?

  projectsManaged Project[] @relation("ProjectManager")
  tasks           Task[]    @relation("Assignees")
  updates         TaskUpdate[]
  teamsLed        Team[]    @relation("TeamLead")
  teams           Team[]    @relation("TeamMembers")
}

model Department {
  id                 String      @id @default(cuid())
  name               String      @unique
  responsibleName    String
  responsibleTitle   String
  responsiblePhone   String
  projects           Project[]
  responsibleForMilestones Milestone[]
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  statusId         String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId     String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  projectManagerId String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  milestones       Milestone[]
  blockers         Blocker[]
  teams            Team[]
}

model Milestone {
  id                     String       @id @default(cuid())
  title                  String
  description            String
  dueDate                DateTime
  weight                 Int
  projectId              String
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks                  Task[]
  responsibleDepartments Department[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestoneId String
  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignees   User[]     @relation("Assignees")
  updates     TaskUpdate[]
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}

model TaskUpdate {
  id        String         @id @default(cuid())
  text      String
  type      TaskUpdateType @default(COMMENT)
  createdAt DateTime       @default(now())
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  taskId    String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

model Blocker {
  id          String        @id @default(cuid())
  description String
  status      BlockerStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolution  String?
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id         String  @id @default(cuid())
  name       String
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamLeadId String
  teamLead   User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  members    User[]  @relation("TeamMembers")
}
