
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  firstName     String
  lastName      String
  email         String    @unique
  avatar        String?
  phoneNumber   String?
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  roles         Role[]      @relation("UserRoles")
  tasks         Task[]      @relation("TaskAssignees")
  teams         Team[]      @relation("TeamMembers")
  ledTeams      Team[]      @relation("TeamLeads")
  managedProjects Project[] @relation("ProjectManagers")
  taskUpdates   TaskUpdate[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id                  String    @id @default(uuid())
  name                String    @unique
  responsibleName     String
  responsibleTitle    String
  responsiblePhone    String
  users               User[]
  projects            Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ProjectStatus {
  id          String    @id @default(uuid())
  name        String    @unique
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id               String        @id @default(uuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  statusId         String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  departmentId     String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  projectManagerId String
  projectManager   User          @relation("ProjectManagers", fields: [projectManagerId], references: [id])
  milestones       Milestone[]
  teams            Team[]
  blockers         Blocker[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Milestone {
  id          String    @id @default(uuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Int
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  tasks       Task[]
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id           String      @id @default(uuid())
  title        String
  description  String
  status       String // e.g., TODO, IN_PROGRESS, DONE
  startDate    DateTime
  endDate      DateTime
  weight       Int
  progress     Int         @default(0)
  milestoneId  String
  milestone    Milestone   @relation(fields: [milestoneId], references: [id])
  assignees    User[]      @relation("TaskAssignees")
  updates      TaskUpdate[]
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model TaskUpdate {
  id                 String    @id @default(uuid())
  text               String
  type               String    @default("COMMENT")
  progressPercentage Int?
  authorId           String
  author             User      @relation(fields: [authorId], references: [id])
  taskId             String
  task               Task      @relation(fields: [taskId], references: [id])
  createdAt          DateTime  @default(now())
}

model Team {
  id         String   @id @default(uuid())
  name       String
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  teamLeadId String
  teamLead   User     @relation("TeamLeads", fields: [teamLeadId], references: [id])
  members    User[]   @relation("TeamMembers")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Blocker {
  id          String    @id @default(uuid())
  description String
  status      String    @default("OPEN") // e.g., OPEN, RESOLVED
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
