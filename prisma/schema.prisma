// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String    @id @default(cuid())
  name            String
  firstName       String
  lastName        String
  email           String    @unique
  avatar          String?
  phoneNumber     String?
  projects        Project[]
  teams           Team[]    @relation("TeamMembers")
  teamLeads       Team[]    @relation("TeamLead")
  tasks           Task[]    @relation("TaskAssignees")
  taskUpdates     TaskUpdate[]
  roles           Role[]    @relation("UserRoles")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
}

model Project {
  id              String    @id @default(cuid())
  name            String
  description     String
  startDate       DateTime
  endDate         DateTime
  workingYear     String
  status          ProjectStatus @relation(fields: [statusId], references: [id])
  statusId        String
  owningDepartment Department @relation(fields: [departmentId], references: [id])
  departmentId    String
  projectManager  User @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones      Milestone[]
  blockers        Blocker[]
  teams           Team[]
}

model Milestone {
  id                      String    @id @default(cuid())
  title                   String
  description             String
  startDate               DateTime
  dueDate                 DateTime
  weight                  Float
  project                 Project   @relation(fields: [projectId], references: [id])
  projectId               String
  tasks                   Task[]
  responsibleDepartments  Department[] @relation("ResponsibleDepartments")
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String
  status       String // TODO, IN_PROGRESS, PENDING_REVIEW, DONE
  startDate    DateTime
  endDate      DateTime
  weight       Float
  completedAt  DateTime?
  milestone    Milestone   @relation(fields: [milestoneId], references: [id])
  milestoneId  String
  assignees    User[]      @relation("TaskAssignees")
  updates      TaskUpdate[]
}

model Team {
  id         String   @id @default(cuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
}

model Department {
  id                      String      @id @default(cuid())
  name                    String      @unique
  responsibleName         String
  responsibleTitle        String
  responsiblePhone        String
  projects                Project[]
  responsibleForMilestones Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      String // OPEN, RESOLVED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
}

model TaskUpdate {
  id        String   @id @default(cuid())
  text      String
  type      String   // COMMENT, STATUS_CHANGE
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
}

model Setting {
  key   String @id
  value String
}
