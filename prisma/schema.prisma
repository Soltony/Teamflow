
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  password        String
  avatar          String
  phone           String?
  tasks           Task[]       @relation("Assignees")
  managedProjects Project[]    @relation("ProjectManager")
  teams           Team[]       @relation("TeamMembers")
  ledTeams        Team[]       @relation("TeamLead")
  taskUpdates     TaskUpdate[]
}

model Department {
  id                         String      @id @default(cuid())
  name                       String      @unique
  responsibleName            String
  responsibleTitle           String
  responsiblePhone           String
  projects                   Project[]
  responsibleForMilestones   Milestone[] @relation("ResponsibleDepartments")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String        @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department    @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User          @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId String
  teams            Team[]
  milestones       Milestone[]
  blockers         Blocker[]
}

model Milestone {
  id                     String       @id @default(cuid())
  title                  String
  description            String
  startDate              DateTime
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId              String
  responsibleDepartments Department[] @relation("ResponsibleDepartments")
  tasks                  Task[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  milestoneId String
  assignees   User[]     @relation("Assignees")
  updates     TaskUpdate[]
}

model Team {
  id         String  @id @default(cuid())
  name       String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  teamLead   User    @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]  @relation("TeamMembers")
}

model Blocker {
  id          String        @id @default(cuid())
  description String
  status      BlockerStatus
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
}

model TaskUpdate {
  id        String         @id @default(cuid())
  text      String
  type      TaskUpdateType
  createdAt DateTime       @default(now())
  author    User           @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}
