generator client {
  provider = "prisma-client-js"
  binaryTargets = ["debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  password        String
  avatar          String?
  phone           String?
  ledTeams        Team[]    @relation("TeamLead")
  teams           Team[]    @relation("TeamMembers")
  managedProjects Project[]
  assignedTasks   Task[]
  taskUpdates     TaskUpdate[]
}

model Department {
  id                      String      @id @default(cuid())
  name                    String
  responsibleName         String
  responsibleTitle        String
  responsiblePhone        String
  owningProjects          Project[]
  responsibleForMilestones Milestone[]
}

model Team {
  id         String   @id @default(cuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String       @id @default(cuid())
  name             String
  description      String
  startDate        DateTime
  endDate          DateTime
  workingYear      String
  status           ProjectStatus @relation(fields: [statusId], references: [id])
  statusId         String
  owningDepartment Department   @relation(fields: [departmentId], references: [id])
  departmentId     String
  projectManager   User         @relation(fields: [projectManagerId], references: [id])
  projectManagerId String
  milestones       Milestone[]
  teams            Team[]
  blockers         Blocker[]
}

model Blocker {
  id          String    @id @default(cuid())
  description String
  status      BlockerStatus
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

model Milestone {
  id                     String       @id @default(cuid())
  title                  String
  description            String
  dueDate                DateTime
  weight                 Int
  project                Project      @relation(fields: [projectId], references: [id])
  projectId              String
  responsibleDepartments Department[]
  tasks                  Task[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String
  status      TaskStatus
  startDate   DateTime
  endDate     DateTime
  weight      Int
  completedAt DateTime?
  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId String
  assignees   User[]
  updates     TaskUpdate[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

model TaskUpdate {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  type      TaskUpdateType
}

enum TaskUpdateType {
  COMMENT
  STATUS_CHANGE
}
