datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  Admin
  ProjectManager
  Member
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions String[]
  users       User[]   @relation("UserRoles")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id              String       @id @default(cuid())
  name            String
  firstName       String
  lastName        String
  email           String       @unique
  avatar          String?
  phoneNumber     String?      @unique
  roles           Role[]       @relation("UserRoles")
  pmoDivision     PmoDivision? @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId   String?
  managedProjects Project[]    @relation("ProjectManager")
  tasks           Task[]       @relation("TaskAssignees")
  teamsAsLead     Team[]       @relation("TeamLead")
  teamsAsMember   Team[]       @relation("TeamMembers")
  taskUpdates     TaskUpdate[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model PmoDivision {
  id               String    @id @default(cuid())
  name             String    @unique
  responsibleName  String
  responsibleTitle String
  responsiblePhone String
  users            User[]
  projects         Project[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Department {
  id       String               @id @default(cuid())
  name     String               @unique
  projects ProjectToDepartment[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ProjectToDepartment {
  project      Project    @relation(fields: [projectId], references: [id])
  projectId    String
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String

  @@id([projectId, departmentId])
  @@map("_ProjectResponsibleDepartments")
}

enum Currency {
  ETB
  USD
}

model Project {
  id                     String                @id @default(cuid())
  name                   String
  description            String
  startDate              DateTime
  endDate                DateTime
  workingYear            String
  status                 ProjectStatus         @relation(fields: [statusId], references: [id])
  statusId               String
  pmoDivision            PmoDivision           @relation(fields: [pmoDivisionId], references: [id])
  pmoDivisionId          String
  projectManager         User                  @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId       String
  totalCost              Decimal?              @db.Decimal(12, 2)
  currency               Currency              @default(ETB)
  responsibleDepartments ProjectToDepartment[]
  milestones             Milestone[]
  teams                  Team[]
  blockers               Blocker[]
  payments               Payment[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model ProjectStatus {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Team {
  id         String   @id @default(cuid())
  name       String
  project    Project  @relation(fields: [projectId], references: [id])
  projectId  String
  teamLead   User     @relation("TeamLead", fields: [teamLeadId], references: [id])
  teamLeadId String
  members    User[]   @relation("TeamMembers")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  dueDate     DateTime
  weight      Float
  project     Project   @relation(fields: [projectId], references: [id])
  projectId   String
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_REVIEW
  DONE
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      TaskStatus @default(TODO)
  startDate   DateTime
  endDate     DateTime
  weight      Float
  progress    Float      @default(0)
  completedAt DateTime?
  milestone   Milestone  @relation(fields: [milestoneId], references: [id])
  milestoneId String
  assignees   User[]     @relation("TaskAssignees")
  updates     TaskUpdate[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum UpdateType {
  COMMENT
  STATUS_CHANGE
}

model TaskUpdate {
  id                 String     @id @default(cuid())
  text               String
  type               UpdateType @default(COMMENT)
  progressPercentage Float?
  author             User       @relation(fields: [authorId], references: [id])
  authorId           String
  task               Task       @relation(fields: [taskId], references: [id])
  taskId             String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

model Blocker {
  id          String        @id @default(cuid())
  description String
  status      BlockerStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolution  String?
  project     Project       @relation(fields: [projectId], references: [id])
  projectId   String
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Payment {
  id          String        @id @default(cuid())
  title       String
  description String?
  amount      Decimal       @db.Decimal(12, 2)
  status      PaymentStatus @default(PENDING)
  notes       String?
  paymentDate DateTime
  project     Project       @relation(fields: [projectId], references: [id])
  projectId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Setting {
  key   String @id
  value String
}
