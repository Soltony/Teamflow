# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log
firestore-debug.log
# Credentials extracted from the legacy TeamAuthDb backup for the one-time
# authentication migration. Contains real password hashes: treat as a secret,
# never commit. See docs/authentication.md.
/scripts/data/legacy-auth-users.json

# One-time migration artefact extracted from the legacy TeamAuthDb backup.
# Contains real password hashes, emails and phone numbers — never commit it,
# and delete it once the credential import has been run in each environment.
/scripts/data/legacy-auth-users.json

# Uploaded project documents. Deliberately outside the web root so they are
# never served as static assets; see src/lib/documents/storage.ts.
/.document-storage/
scratch/
.tmpwork/

# Database exports from scripts/db-export.ts. These carry real password
# hashes and must never be committed.
*.dump
*.sql.gz
